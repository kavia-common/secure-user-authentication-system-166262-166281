# Application
APP_NAME=Authentication Backend
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*
# FRONTEND_BASE_URL is recommended in production to restrict CORS
# FRONTEND_BASE_URL=https://your-frontend.example.com

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP (Gmail recommended with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Auth System

# Public site URL used in email links (frontend base URL)
SITE_URL=http://localhost:3000

# Security/TTL settings
VERIFICATION_CODE_TTL_SECONDS=600
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
