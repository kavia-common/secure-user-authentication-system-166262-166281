# Application
APP_NAME=Authentication Backend
APP_ENV=development
APP_DEBUG=true
# Optional explicit log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# CORS
# Used in non-production or as fallback
CORS_ALLOW_ORIGINS=*
# In production, preferred strict origin for CORS
FRONTEND_BASE_URL=https://frontend.example.com

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Auth System

# URLs
SITE_URL=https://app.example.com
