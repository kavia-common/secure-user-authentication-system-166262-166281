# Application
APP_NAME=Authentication Backend
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*

# Frontend URL for redirects and CORS (set in production)
FRONTEND_BASE_URL=https://app.example.com
SITE_URL=https://app.example.com

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMTP (Gmail example - use app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Auth System

# Optional TTL overrides (seconds)
VERIFICATION_CODE_TTL_SECONDS=600
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
