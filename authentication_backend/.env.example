# Authentication Backend - .env.example
# Copy this file to .env and fill in the real values.
# Notes:
# - Do NOT commit your real .env to source control.
# - These example values use the Kavia preview URLs instead of localhost.
# - Replace placeholders like <your-supabase-url> and <service-role-key> with actual values.

# -----------------------------------------------------------------------------
# App configuration
# -----------------------------------------------------------------------------
APP_NAME=Authentication Backend
APP_ENV=development
APP_DEBUG=true
# LOG_LEVEL can be one of: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# CORS:
# In production, prefer restricting to a single frontend origin via FRONTEND_BASE_URL.
# For preview environments, set to your Kavia frontend preview URL.
FRONTEND_BASE_URL=https://vscode-internal-27740-beta.beta01.cloud.kavia.ai:3000
# Or allow multiple origins (comma-separated); leave empty to disable strict list.
# CORS_ALLOW_ORIGINS=https://vscode-internal-27740-beta.beta01.cloud.kavia.ai:3000

# -----------------------------------------------------------------------------
# Supabase (Required)
# -----------------------------------------------------------------------------
# Supabase project URL, e.g., https://xyzcompany.supabase.co
SUPABASE_URL=<your-supabase-url>
# Supabase Service Role key (server-side ONLY, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# -----------------------------------------------------------------------------
# SMTP (Required for sending emails)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail-address>
SMTP_PASSWORD=<your-gmail-app-password>
SMTP_FROM_EMAIL=<your-from-email>
# Optional display name
SMTP_FROM_NAME=Auth System

# -----------------------------------------------------------------------------
# Public Site URL used in emails (e.g., verification/recovery redirect)
# This must match your frontend's public URL so that Supabase auth links redirect correctly.
# Updated to use Kavia preview frontend URL instead of localhost.
# Example (Kavia preview):
SITE_URL=https://vscode-internal-27740-beta.beta01.cloud.kavia.ai:3000

# -----------------------------------------------------------------------------
# Security / TTLs
# -----------------------------------------------------------------------------
# Time-to-live for email verification codes (seconds)
VERIFICATION_CODE_TTL_SECONDS=600
# Time-to-live for password reset token (seconds)
PASSWORD_RESET_TOKEN_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Frontend tooling hints (if applicable)
# -----------------------------------------------------------------------------
# If your frontend needs to call the backend directly, set this on the frontend:
# REACT_APP_BACKEND_URL=https://vscode-internal-27740-beta.beta01.cloud.kavia.ai:3001
# If the frontend also uses Supabase client-side, it will need:
# REACT_APP_SUPABASE_URL=<your-supabase-url>
# REACT_APP_SUPABASE_KEY=<your-supabase-anon-key>
