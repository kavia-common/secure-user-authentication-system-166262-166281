# Application
APP_NAME=Authentication Backend
APP_ENV=development
APP_DEBUG=true
CORS_ALLOW_ORIGINS=*

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Auth System

# Site URL used in emails (links/redirects)
SITE_URL=http://localhost:3000

# Security
VERIFICATION_CODE_TTL_SECONDS=600
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
