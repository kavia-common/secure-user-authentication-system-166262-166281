# Authentication Backend - .env.example
# Copy to .env and fill with your new Supabase project credentials and SMTP settings.

# App
APP_NAME=Authentication Backend
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# CORS (production: set FRONTEND_BASE_URL or limit CORS_ALLOW_ORIGINS)
CORS_ALLOW_ORIGINS=*
# FRONTEND_BASE_URL=https://your-frontend.example.com

# Supabase (REQUIRED)
# Use your NEW Supabase project values:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP (REQUIRED for email code delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Auth System

# Public site URL used in emails (frontend)
SITE_URL=http://localhost:3000

# Optional tuning
VERIFICATION_CODE_TTL_SECONDS=600
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
